modules = ["nodejs-20", "python-3.12", "web"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/forex-dashboard: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/api-server: API Server"

[[workflows.workflow]]
name = "artifacts/forex-dashboard: web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/forex-dashboard run dev"
waitForPort = 22059

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "artifacts/api-server: API Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && pip install -r requirements.txt -q && python main.py"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
AI_INFERENCE_DEVICE = "cpu"
AI_MIN_CONFIDENCE = "0.75"
AI_MODEL_PATH = "./models"
ALLOWED_ORIGINS = "[\"*\"]"
APP_DEBUG = "false"
APP_ENV = "development"
APP_HOST = "0.0.0.0"
APP_PORT = "8000"
BACKTEST_WORKERS = "4"
DEFAULT_LOT_SIZE = "0.01"
LOG_FILE = "./logs/forex_bot.log"
LOG_FORMAT = "json"
LOG_LEVEL = "INFO"
MARKET_DATA_PROVIDER = "yfinance"
MARKET_SCAN_INTERVAL_SECONDS = "60"
MAX_DAILY_LOSS_PERCENT = "5.0"
MAX_OPEN_TRADES = "5"
NEWS_FILTER_ENABLED = "true"
NEWS_HIGH_IMPACT_BLOCK_MINUTES = "30"
RISK_PER_TRADE_PERCENT = "1.0"
