# ─────────────────────────────────────────────────────────────────
#  AI Forex Trading Bot — Environment Variables
#  Copy this file to .env and fill in all values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ─── Application ─────────────────────────────────────────────────
APP_ENV=development                        # development | staging | production
APP_SECRET_KEY=change-me-to-a-random-64-char-string
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/forex_bot
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── JWT / Auth ──────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-different-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── MT5 / Exness Integration ────────────────────────────────────
MT5_ACCOUNT=0                              # Your MT5 account number
MT5_PASSWORD=your-mt5-password
MT5_SERVER=Exness-MT5Real                 # Broker server name
MT5_TERMINAL_PATH=                        # Windows path to MT5 terminal (if needed)

# ─── AI Engine ───────────────────────────────────────────────────
AI_MODEL_PATH=./models                     # Directory containing trained model files
AI_MIN_CONFIDENCE=0.75                     # Minimum signal confidence threshold (0–1)
AI_INFERENCE_DEVICE=cpu                    # cpu | cuda | mps

# ─── Market Data (MT5/Exness only — no external providers) ──────
# The Market Data Engine uses ONLY MT5/Exness as its single source of truth.
# Yahoo Finance, Alpha Vantage, and other external feeds are NOT used.
MARKET_SCAN_INTERVAL_SECONDS=60          # Candle-check / scanner interval (seconds)
MARKET_TICK_INTERVAL_SECONDS=5           # Live tick poll interval (seconds)
MT5_RECONNECT_ATTEMPTS=5                 # Max reconnect retries after mid-session disconnect
MT5_RECONNECT_DELAY_SECONDS=2.0          # Base back-off delay (s); doubles each retry

# ─── News / Economic Calendar ────────────────────────────────────
NEWS_API_KEY=                              # forexfactory | investing.com / custom feed
NEWS_FILTER_ENABLED=true
NEWS_HIGH_IMPACT_BLOCK_MINUTES=30         # Block trading N minutes before high-impact events

# ─── Risk Management ─────────────────────────────────────────────
RISK_PER_TRADE_PERCENT=1.0                # % of balance risked per trade
MAX_OPEN_TRADES=5
MAX_DAILY_LOSS_PERCENT=5.0               # Daily drawdown kill-switch
DEFAULT_LOT_SIZE=0.01

# ─── Backtesting ─────────────────────────────────────────────────
BACKTEST_DATA_PATH=./data/historical      # Directory of OHLCV CSV files
BACKTEST_WORKERS=4                        # Parallel worker count

# ─── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=INFO                            # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                           # json | text
LOG_FILE=./logs/forex_bot.log
